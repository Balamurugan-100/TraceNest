          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum(rate(apm_duration_milliseconds_bucket{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__rate_interval])) by (le))",
          "legendFormat": "P95 Latency",
