      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.50, sum(rate(apm_duration_milliseconds_bucket{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__rate_interval])) by (le))",
          "legendFormat": "P50 Latency",
          "range": true,
