        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route, http_method) (rate(apm_duration_milliseconds_bucket{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "P95",
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, http_route, http_method) (rate(apm_duration_milliseconds_bucket{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "P99",
          "range": false,
          "refId": "F"
