    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Primary navigation: Complete breakdown of Django routes with Method, RPS, error rates, latency percentiles, and 1-click drilldown into Endpoint Details.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(Method|http_method)$/"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              },
              {
                "id": "custom.filterable",
                "value": false
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "DELETE": {
