      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (http_route, http_method) (rate(apm_calls_total{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "RPS",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(((sum by (http_route, http_method) (rate(apm_calls_total{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\", error=\"true\"}[$__range]))) or (0 * sum by (http_route, http_method) (rate(apm_calls_total{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__range])))) / (sum by (http_route, http_method) (rate(apm_calls_total{span_name=\"django.request\", service_name=~\"$service\", http_method=~\"$http_method\"}[$__range])) > 0)) * 100",
          "format": "table",
          "instant": true,
          "legendFormat": "Error Rate",
          "range": false,
          "refId": "C"
