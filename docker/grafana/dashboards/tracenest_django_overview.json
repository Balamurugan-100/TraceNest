        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 9,
      "options": {
        "enablePagination": true,
        "footer": {
          "countRows": true,
          "enablePagination": true,
          "fields": "",
          "reducer": [
            "mean"
          ],
          "show": true
