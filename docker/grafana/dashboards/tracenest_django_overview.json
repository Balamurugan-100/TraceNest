                        "index": 3
                      },
                      "GET": {
                        "color": "#10b981",
                        "index": 0
                      },
                      "PATCH": {
                        "color": "#8b5cf6",
                        "index": 4
                      },
                      "POST": {
                        "color": "#3b82f6",
                        "index": 1
                      },
                      "PUT": {
                        "color": "#f59e0b",
                        "index": 2
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(Endpoint|http_route)$/"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Endpoint Details: ${__data.fields.Endpoint}",
                    "url": "/d/tracenest-django-endpoint?var-endpoint=${__data.fields.Endpoint:percentencode}&var-http_method=${__data.fields.Method}&var-service=${service}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "RPS"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Error Rate %"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
