            },
            "indexByName": {
              "http_method": 0,
              "Method": 0,
              "http_route": 1,
              "Endpoint": 1,
              "Value #A": 2,
              "RPS": 2,
              "Value #C": 3,
              "Error Rate %": 3,
              "Value #D": 4,
              "P50 Latency": 4,
              "Value #E": 5,
              "P95 Latency": 5,
              "Value #F": 6,
              "P99 Latency": 6
            },
            "renameByName": {
              "http_method": "Method",
              "http_route": "Endpoint",
              "Value #A": "RPS",
              "Value #C": "Error Rate %",
              "Value #D": "P50 Latency",
              "Value #E": "P95 Latency",
              "Value #F": "P99 Latency"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "RPS",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
